@{
    ViewData["Title"] = "404 - Không tìm thấy trang";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex flex-column align-items-center justify-content-center text-center py-5" style="min-height: 70vh;">

    <div class="mb-4">
        <h1 class="display-1 fw-bold text-primary" style="font-size: 8rem; text-shadow: 5px 5px 0px rgba(0,0,0,0.1);">
            4<i class="far fa-question-circle text-warning mx-2"></i>4
        </h1>
    </div>

    <h2 class="fw-bold text-dark mb-3">Oops! Trang này không tồn tại.</h2>
    <p class="text-muted lead mb-5" style="max-width: 600px;">
        Có vẻ như trang bạn đang tìm kiếm đã bị xóa, đổi tên hoặc tạm thời không truy cập được.
        Nếu bạn đang cố truy cập vào khu vực Admin, hãy chắc chắn rằng bạn có đủ quyền hạn.
    </p>

    <div class="d-flex gap-3">
        <a href="/" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
            <i class="fas fa-home me-2"></i> Về trang chủ
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold">
            <i class="fas fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>
</div>