@model NetNews.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="row mb-4">
    @if (Model.FeaturedPosts.Any())
    {
        var firstPost = Model.FeaturedPosts.First();
        <div class="col-lg-8 mb-3">
            <div class="card text-white border-0 shadow-sm h-100 overflow-hidden">
                <img src="@(string.IsNullOrEmpty(firstPost.Thumbnail) ? "https://placehold.co/800x450" : firstPost.Thumbnail)"
                     class="card-img h-100 object-fit-cover"
                     style="filter: brightness(0.7);" alt="@firstPost.Title">
                <div class="card-img-overlay d-flex flex-column justify-content-end p-4">
                    <span class="badge bg-danger mb-2 w-auto align-self-start">Nổi bật</span>
                    <h2 class="card-title fw-bold">
                        <a href="/Post/Details/@firstPost.Slug" class="text-white text-decoration-none">@firstPost.Title</a>
                    </h2>
                    <p class="card-text d-none d-md-block">@firstPost.Description</p>
                    <small class="text-light">
                        <i class="far fa-clock"></i> @firstPost.CreatedAt.ToString("dd/MM/yyyy") &bull;
                        Bởi <strong>@firstPost.Author?.UserName</strong>
                    </small>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="row h-100">
                @foreach (var item in Model.FeaturedPosts.Skip(1).Take(2))
                {
                    <div class="col-12 mb-3 h-50">
                        <div class="card border-0 shadow-sm h-100 text-white overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "https://placehold.co/400x250" : item.Thumbnail)"
                                 class="card-img h-100 object-fit-cover"
                                 style="filter: brightness(0.6);">
                            <div class="card-img-overlay d-flex flex-column justify-content-end p-3">
                                <span class="badge bg-primary mb-1 align-self-start">@item.Category?.Name</span>
                                <h5 class="card-title">
                                    <a href="/Post/Details/@item.Slug" class="text-white text-decoration-none">@item.Title</a>
                                </h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="row">
    <div class="col-lg-8">
        @foreach (var box in Model.CategoryBoxes)
        {
            <div class="category-box mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-2 border-primary">
                    <h3 class="fw-bold text-white bg-primary px-3 py-1 mb-0 shadow-sm" style="font-size: 1.2rem;">
                        @box.CategoryName
                    </h3>
                    <a href="/Category/@box.CategorySlug" class="text-decoration-none small fw-bold">Xem thêm <i class="fas fa-angle-double-right"></i></a>
                </div>

                <div class="row g-3">
                    @if (box.Posts.Any())
                    {
                        var mainPost = box.Posts.First();
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100 hover-shadow">
                                <a href="/Post/Details/@mainPost.Slug">
                                    <img src="@(string.IsNullOrEmpty(mainPost.Thumbnail) ? "https://placehold.co/400x250" : mainPost.Thumbnail)" class="card-img-top object-fit-cover" height="200" alt="@mainPost.Title">
                                </a>
                                <div class="card-body">
                                    <h5 class="fw-bold">
                                        <a href="/Post/Details/@mainPost.Slug" class="text-dark text-decoration-none">@mainPost.Title</a>
                                    </h5>
                                    <p class="text-muted small mb-0 line-clamp-2">@mainPost.Description</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            @foreach (var subPost in box.Posts.Skip(1))
                            {
                                <div class="d-flex mb-3 align-items-center gap-3 border-bottom pb-2">
                                    <img src="@(string.IsNullOrEmpty(subPost.Thumbnail) ? "https://placehold.co/100x70" : subPost.Thumbnail)" class="rounded object-fit-cover shadow-sm" style="width: 80px; height: 60px;">
                                    <h6 class="mb-0 fw-bold" style="font-size: 0.9rem;">
                                        <a href="/Post/Details/@subPost.Slug" class="text-dark text-decoration-none hover-primary">@subPost.Title</a>
                                    </h6>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <h4 class="fw-bold border-start border-4 border-dark ps-3 mb-4">Mới cập nhật</h4>
        @foreach (var item in Model.RecentPosts)
        {
            <div class="card mb-3 border-0 shadow-sm hover-shadow overflow-hidden">
                <div class="row g-0">
                    <div class="col-md-4">
                        <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "https://placehold.co/300x200" : item.Thumbnail)" class="img-fluid h-100 object-fit-cover" alt="@item.Title">
                    </div>
                    <div class="col-md-8 p-3">
                        <h5 class="fw-bold"><a href="/Post/Details/@item.Slug" class="text-dark text-decoration-none">@item.Title</a></h5>
                        <p class="text-muted small mb-2 line-clamp-2">@item.Description</p>
                        <div class="text-muted" style="font-size: 0.8rem;">
                            <i class="far fa-clock"></i> @item.CreatedAt.ToString("dd/MM/yyyy") | <i class="fas fa-eye"></i> @item.ViewCount
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 border-0 shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-dark text-white fw-bold py-3">
                <i class="fas fa-bolt text-warning me-2"></i> XU HƯỚNG ĐỌC
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.MostViewedPosts.Select((value, i) => new { i, value }))
                    {
                        <li class="list-group-item d-flex gap-3 py-3 border-0 border-bottom">
                            <span class="fw-bold text-muted h4 mb-0">0@(item.i + 1)</span>
                            <a href="/Post/Details/@item.value.Slug" class="text-decoration-none text-dark fw-bold small">@item.value.Title</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .hover-primary:hover {
        color: #0d6efd !important;
    }

    .category-box h3 {
        border-radius: 5px 5px 0 0;
    }
</style>