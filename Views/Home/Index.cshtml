@model NetNews.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<div class="row mb-4">
    @if (Model.FeaturedPosts.Any())
    {
        var firstPost = Model.FeaturedPosts.First();
        <div class="col-lg-8 mb-3">
            <div class="card text-white border-0 shadow-sm h-100 overflow-hidden">
                <img src="@(string.IsNullOrEmpty(firstPost.Thumbnail) ? "https://placehold.co/800x450" : firstPost.Thumbnail)"
                     class="card-img h-100 object-fit-cover"
                     style="filter: brightness(0.7);" alt="@firstPost.Title">
                <div class="card-img-overlay d-flex flex-column justify-content-end p-4">
                    <span class="badge bg-danger mb-2 w-auto align-self-start">Nổi bật</span>
                    <h2 class="card-title fw-bold">
                        <a href="/Post/Details/@firstPost.Slug" class="text-white text-decoration-none">@firstPost.Title</a>
                    </h2>
                    <p class="card-text d-none d-md-block">@firstPost.Description</p>
                    <small class="text-light">
                        <i class="far fa-clock"></i> @firstPost.CreatedAt.ToString("dd/MM/yyyy") &bull;
                        Bởi <strong>@firstPost.Author?.UserName</strong>
                    </small>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="row h-100">
                @foreach (var item in Model.FeaturedPosts.Skip(1).Take(2))
                {
                    <div class="col-12 mb-3 h-50">
                        <div class="card border-0 shadow-sm h-100 text-white overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "https://placehold.co/400x250" : item.Thumbnail)"
                                 class="card-img h-100 object-fit-cover"
                                 style="filter: brightness(0.6);">
                            <div class="card-img-overlay d-flex flex-column justify-content-end p-3">
                                <span class="badge bg-primary mb-1 align-self-start">@item.Category?.Name</span>
                                <h5 class="card-title">
                                    <a href="/Post/Details/@item.Slug" class="text-white text-decoration-none">@item.Title</a>
                                </h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
            <h3 class="fw-bold text-dark border-start border-4 border-primary ps-3">Tin mới nhất</h3>
        </div>

        @foreach (var item in Model.RecentPosts)
        {
            <div class="card mb-3 border-0 shadow-sm hover-shadow">
                <div class="row g-0">
                    <div class="col-md-4">
                        <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "https://placehold.co/300x200" : item.Thumbnail)"
                             class="img-fluid rounded-start h-100 object-fit-cover" alt="@item.Title">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                <a href="/Post/Details/@item.Slug" class="text-dark text-decoration-none">@item.Title</a>
                            </h5>
                            <p class="card-text text-muted small">@item.Description</p>
                            <p class="card-text">
                                <small class="text-muted">
                                    <span class="badge bg-light text-dark border me-2">@item.Category?.Name</span>
                                    <i class="far fa-calendar-alt"></i> @item.CreatedAt.ToString("dd/MM/yyyy") &bull;
                                    <i class="fas fa-eye"></i> @item.ViewCount lượt xem
                                </small>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header bg-white fw-bold text-uppercase border-bottom-0">
                <i class="fas fa-fire text-danger"></i> Đọc nhiều nhất
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in Model.MostViewedPosts.Select((value, i) => new { i, value }))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="/Post/Details/@item.value.Slug" class="text-decoration-none text-dark small">@item.value.Title</a>
                        <span class="badge bg-secondary rounded-pill">@(item.i + 1)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<style>
    .object-fit-cover {
        object-fit: cover;
    }

    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        transition: all 0.3s ease;
    }
</style>