@model NetNews.Models.Post

@{
    ViewData["Title"] = Model.Title;
    var relatedPosts = ViewBag.RelatedPosts as List<NetNews.Models.Post>;
}

<nav aria-label="breadcrumb" class="bg-light p-3 rounded mb-4">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item">
            <a href="/Home/Category?slug=@Model.Category?.Slug" class="text-decoration-none">@Model.Category?.Name</a>
        </li>
        <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        <article class="blog-post">
            <header class="mb-4">
                <span class="badge bg-primary mb-2">@Model.Category?.Name</span>
                <h1 class="fw-bold mb-3">@Model.Title</h1>

                <div class="d-flex align-items-center text-muted small border-bottom pb-3 mb-4">
                    <div class="me-3">
                        <i class="far fa-user me-1"></i> <strong>@Model.Author?.UserName</strong>
                    </div>
                    <div class="me-3">
                        <i class="far fa-calendar-alt me-1"></i> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>
                    <div>
                        <i class="fas fa-eye me-1"></i> @Model.ViewCount lượt xem
                    </div>
                </div>
            </header>

            <div class="fw-bold fs-5 mb-4 fst-italic text-secondary">
                @Model.Description
            </div>

            <div class="article-content mb-5">
                @Html.Raw(Model.Content)
            </div>

            <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded mb-5">
                <div class="fw-bold text-muted">Chia sẻ:</div>
                <div>
                    <button class="btn btn-outline-primary btn-sm rounded-circle me-1"><i class="fab fa-facebook-f"></i></button>
                    <button class="btn btn-outline-info btn-sm rounded-circle me-1"><i class="fab fa-twitter"></i></button>
                    <button class="btn btn-outline-danger btn-sm rounded-circle"><i class="fab fa-pinterest"></i></button>
                </div>
            </div>
        </article>

        @if (relatedPosts != null && relatedPosts.Any())
        {
            <div class="related-posts mb-5">
                <h4 class="fw-bold border-bottom border-3 border-primary pb-2 mb-4">Bài viết liên quan</h4>
                <div class="row">
                    @foreach (var item in relatedPosts)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card h-100 border-0 shadow-sm hover-shadow">
                                <a href="/Post/Details/@item.Slug">
                                    <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "https://placehold.co/300x200" : item.Thumbnail)"
                                         class="card-img-top object-fit-cover" height="150" alt="@item.Title">
                                </a>
                                <div class="card-body p-3">
                                    <h6 class="card-title fw-bold">
                                        <a href="/Post/Details/@item.Slug" class="text-dark text-decoration-none">@item.Title</a>
                                    </h6>
                                    <small class="text-muted"><i class="far fa-clock"></i> @item.CreatedAt.ToString("dd/MM")</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="comments-section">
            <h4 class="fw-bold mb-3">Bình luận</h4>
            <div class="alert alert-secondary text-center p-4">
                Tính năng bình luận đang được phát triển.
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-3">Tìm kiếm</h5>
                <form action="/Home/Search" method="get">
                    <div class="input-group">
                        <input type="text" name="query" class="form-control" placeholder="Tìm kiếm...">
                        <button class="btn btn-primary" type="button"><i class="fas fa-search"></i></button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-4 border-0 shadow-sm sticky-top" style="top: 80px; z-index: 1;">
            <img src="https://placehold.co/400x600/eee/333?text=Quang+Cao+Doc" class="img-fluid rounded">
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .article-content img {
            max-width: 100% !important;
            height: auto !important;
            border-radius: 5px;
            margin: 15px 0;
            display: block;
            margin-left: auto;
            margin-right: auto;
        }

        .article-content {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #333;
        }

            .article-content h2, .article-content h3 {
                font-weight: bold;
                margin-top: 1.5rem;
                margin-bottom: 1rem;
            }

        .hover-shadow:hover {
            transform: translateY(-3px);
            transition: all 0.3s;
        }
    </style>
}