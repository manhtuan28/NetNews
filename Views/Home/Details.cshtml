@model NetNews.Models.Post

@{
    ViewData["Title"] = Model.Title;
    var relatedPosts = ViewBag.RelatedPosts as List<NetNews.Models.Post>;
}

<div class="row mt-4">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small bg-light p-2 rounded">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-dark"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item"><a href="/Category/@Model.Category?.Slug" class="text-decoration-none text-primary">@Model.Category?.Name</a></li>
                <li class="breadcrumb-item active text-truncate" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <article class="blog-post">
            <h1 class="fw-bold display-6 mb-3">@Model.Title</h1>

            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div class="user-info d-flex align-items-center">
                    <img src="https://ui-avatars.com/api/?name=@Model.Author?.UserName&background=random" class="rounded-circle me-2" width="40" height="40">
                    <div class="small">
                        <div class="fw-bold">@Model.Author?.UserName</div>
                        <div class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") • <i class="fas fa-eye"></i> @Model.ViewCount lượt xem</div>
                    </div>
                </div>

                <div class="post-actions">
                    <button class="btn btn-light btn-sm border rounded-pill px-3" onclick="copyCurrentUrl()" id="btnShare">
                        <i class="fas fa-share-alt me-1"></i> Chia sẻ
                    </button>
                    <button class="btn btn-light btn-sm border rounded-pill px-2" onclick="changeFontSize(1)" title="Tăng cỡ chữ">A+</button>
                    <button class="btn btn-light btn-sm border rounded-pill px-2" onclick="changeFontSize(-1)" title="Giảm cỡ chữ">A-</button>
                </div>
            </div>

            <p class="lead fw-bold text-secondary mb-4" style="border-left: 4px solid #0d6efd; padding-left: 15px;">
                @Model.Description
            </p>

            <div class="article-content mb-5" id="articleBody">
                @Html.Raw(Model.Content)
            </div>

            <div class="mb-5">
                <span class="fw-bold me-2"><i class="fas fa-tags"></i> Tags:</span>
                <a href="#" class="badge bg-light text-dark border text-decoration-none">#NetNews</a>
                <a href="#" class="badge bg-light text-dark border text-decoration-none">#TinTuc24h</a>
            </div>

            <hr />

            <div class="related-posts mt-5">
                <h4 class="fw-bold mb-4 border-start border-4 border-primary ps-3">Bài viết liên quan</h4>
                <div class="row g-4">
                    @if (relatedPosts != null && relatedPosts.Any())
                    {
                        foreach (var item in relatedPosts)
                        {
                            <div class="col-md-4">
                                <div class="card h-100 border-0 shadow-sm hover-shadow-lg transition">
                                    <a href="/Post/Details/@item.Slug">
                                        <img src="@(string.IsNullOrEmpty(item.Thumbnail) ? "https://placehold.co/400x250" : item.Thumbnail)"
                                             class="card-img-top object-fit-cover" height="150" alt="@item.Title">
                                    </a>
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold mb-0">
                                            <a href="/Post/Details/@item.Slug" class="text-dark text-decoration-none line-clamp-2">@item.Title</a>
                                        </h6>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted italic ps-3">Chưa có bài viết liên quan nào.</p>
                    }
                </div>
            </div>

            <div class="comments-section mt-5 border-top pt-4">
                <h4 class="fw-bold mb-4"><i class="fas fa-comments me-2 text-primary"></i>Đánh giá & Bình luận</h4>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="card border-0 shadow-sm mb-5 bg-light p-4">
                        <form asp-action="PostComment" method="post">
                            <input type="hidden" name="postId" value="@Model.Id" />

                            <div class="mb-3 d-flex align-items-center gap-3">
                                <span class="fw-bold">Đánh giá của bạn:</span>
                                <div class="star-rating fs-4" style="cursor: pointer; color: #ccc;">
                                    <i class="far fa-star" data-value="1"></i>
                                    <i class="far fa-star" data-value="2"></i>
                                    <i class="far fa-star" data-value="3"></i>
                                    <i class="far fa-star" data-value="4"></i>
                                    <i class="far fa-star" data-value="5"></i>
                                </div>
                                <input type="hidden" name="rating" id="selectedRating" value="5" />
                            </div>

                            <div class="mb-3">
                                <textarea name="content" class="form-control" rows="3" placeholder="Chia sẻ cảm nghĩ của bạn về bài viết..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Gửi bình luận</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-info rounded-pill text-center shadow-sm">
                        Vui lòng <a href="/Identity/Account/Login" class="fw-bold">đăng nhập</a> để đánh giá và bình luận.
                    </div>
                }

                <div class="comment-list">
                    @foreach (var comment in Model.Comments.Where(c => c.ParentId == null).OrderByDescending(c => c.CreatedAt))
                    {
                        <div class="d-flex mb-4 p-3 bg-white rounded shadow-sm border">
                            <img src="https://ui-avatars.com/api/?name=@comment.User.UserName&background=random" class="rounded-circle me-3" width="50" height="50">
                            <div class="w-100">
                                <div class="d-flex justify-content-between">
                                    <h6 class="fw-bold mb-1">@comment.User.UserName</h6>
                                    <small class="text-muted">@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="text-warning small mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= comment.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                                <p class="mb-2 text-dark">@comment.Content</p>
                                <button class="btn btn-sm btn-link text-decoration-none p-0 fw-bold" onclick="showReplyForm(@comment.Id)">
                                    <i class="fas fa-reply me-1"></i> Trả lời
                                </button>

                                <div id="replyForm-@comment.Id" class="mt-3 d-none">
                                    <form asp-action="PostComment" method="post">
                                        <input type="hidden" name="postId" value="@Model.Id" />
                                        <input type="hidden" name="parentId" value="@comment.Id" />
                                        <input type="hidden" name="rating" value="5" />
                                        <textarea name="content" class="form-control form-control-sm mb-2" rows="2" placeholder="Viết câu trả lời..." required></textarea>
                                        <button type="submit" class="btn btn-sm btn-secondary rounded-pill px-3">Phản hồi</button>
                                    </form>
                                </div>

                                @foreach (var reply in comment.Replies)
                                {
                                    <div class="d-flex mt-3 p-2 bg-light rounded border-start border-3 border-primary">
                                        <img src="https://ui-avatars.com/api/?name=@reply.User.UserName&background=random" class="rounded-circle me-2" width="30" height="30">
                                        <div>
                                            <h6 class="small fw-bold mb-0">@reply.User.UserName</h6>
                                            <p class="small mb-0">@reply.Content</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            </nav>
    </div>

    <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Tìm kiếm tin tức</h5>
                <form action="/Home/Search" method="get">
                    <div class="input-group">
                        <input type="text" name="query" class="form-control" placeholder="Nhập từ khóa...">
                        <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i></button>
                    </div>
                </form>
            </div>
        </div>

        <div class="sticky-top" style="top: 80px;">
            <div class="card mb-4 border-0 shadow-sm overflow-hidden text-center">
                <div class="card-header bg-dark text-white fw-bold"><i class="fas fa-ad me-2"></i>Tài trợ</div>
                <img src="https://placehold.co/400x600/f8f9fa/333?text=Quảng+Cáo+Tại+Đây" class="img-fluid w-100">
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="copyToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-check-circle me-2"></i> Đã sao chép liên kết vào bộ nhớ tạm!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeFontSize(delta) {
            const content = document.getElementById('articleBody');
            const currentSize = parseFloat(window.getComputedStyle(content, null).getPropertyValue('font-size'));
            content.style.fontSize = (currentSize + delta) + 'px';
        }

        function copyCurrentUrl() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(() => {
                const toastLiveExample = document.getElementById('copyToast');
                const toast = new bootstrap.Toast(toastLiveExample);
                toast.show();

                const btn = document.getElementById('btnShare');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check"></i> Đã copy';
                btn.classList.replace('btn-light', 'btn-success');

                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.replace('btn-success', 'btn-light');
                }, 2000);
            }).catch(err => {
                console.error('Lỗi khi copy: ', err);
            });
        }

        const stars = document.querySelectorAll('.star-rating i');
        const ratingInput = document.getElementById('selectedRating');

        stars.forEach(star => {
            star.addEventListener('mouseover', function() {
                highlightStars(this.dataset.value);
            });

            star.addEventListener('click', function() {
                ratingInput.value = this.dataset.value;
                highlightStars(this.dataset.value, true);
            });
        });

        function highlightStars(val, isFixed = false) {
            stars.forEach(s => {
                if (s.dataset.value <= val) {
                    s.classList.replace('far', 'fas');
                    s.style.color = "#ffc107";
                } else {
                    if (!isFixed || s.dataset.value > ratingInput.value) {
                        s.classList.replace('fas', 'far');
                        s.style.color = "#ccc";
                    }
                }
            });
        }

        document.querySelector('.star-rating').addEventListener('mouseleave', () => {
            highlightStars(ratingInput.value, true);
        });

        function showReplyForm(id) {
            const form = document.getElementById('replyForm-' + id);
            form.classList.toggle('d-none');
        }
    </script>

    <style>
        .article-content {
            font-size: 1.15rem;
            line-height: 1.9;
            color: #222;
            text-align: justify;
        }

            .article-content figure.image {
                display: table;
                margin: 2rem auto;
                max-width: 100%;
                clear: both;
                text-align: center;
            }

                .article-content figure.image img {
                    display: block;
                    margin: 0 auto;
                    max-width: 100%;
                    height: auto;
                    border-radius: 8px;
                    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                }

                .article-content figure.image figcaption {
                    display: table-caption;
                    caption-side: bottom;
                    background: #f8f9fa;
                    color: #666;
                    font-size: 0.95rem;
                    font-style: italic;
                    padding: 10px;
                    text-align: center;
                    border-bottom: 2px solid #0d6efd;
                    width: 100%;
                    margin-top: 5px;
                }

            .article-content h2, .article-content h3 {
                font-weight: bold;
                margin-top: 2.5rem;
                margin-bottom: 1.2rem;
                color: #0d6efd;
            }

            .article-content blockquote {
                border-left: 5px solid #0d6efd;
                padding: 15px 25px;
                font-style: italic;
                color: #444;
                margin: 2rem 0;
                background: #f1f7ff;
            }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .transition {
            transition: all 0.3s ease;
        }

        .hover-shadow-lg:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }
    </style>
}