@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <span class="fa-stack fa-4x">
                    <i class="fas fa-circle fa-stack-2x text-danger opacity-25"></i>
                    <i class="fas fa-lock fa-stack-1x text-danger"></i>
                </span>
            </div>

            <h1 class="fw-bold text-danger mb-3">403 - Forbidden</h1>
            <h2 class="h5 text-dark fw-bold mb-3">@ViewData["Title"]</h2>

            <p class="text-muted mb-4">
                Xin lỗi, tài khoản của bạn không có đủ thẩm quyền để truy cập vào tài nguyên này.<br />
                Vui lòng liên hệ với quản trị viên nếu bạn cho rằng đây là một sự nhầm lẫn.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fas fa-arrow-left me-2"></i>Về trang chủ
                </a>
                <a asp-page="./Login" class="btn btn-primary rounded-pill px-4">
                    <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>