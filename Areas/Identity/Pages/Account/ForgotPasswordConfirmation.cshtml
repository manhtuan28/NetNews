@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Đã gửi email xác nhận";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 text-center">
            <div class="card-body p-5">
                <div class="mb-4">
                    <span class="fa-stack fa-3x text-success">
                        <i class="fas fa-circle fa-stack-2x opacity-25"></i>
                        <i class="fas fa-envelope-open-text fa-stack-1x"></i>
                    </span>
                </div>

                <h2 class="fw-bold mb-3">Kiểm tra hộp thư của bạn</h2>

                <p class="text-muted mb-4">
                    Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu đến email của bạn.<br>
                    Vui lòng kiểm tra (cả hộp thư rác nếu cần) và làm theo hướng dẫn.
                </p>

                <div class="d-grid gap-2">
                    <a asp-page="./Login" class="btn btn-outline-primary fw-bold">
                        <i class="fas fa-sign-in-alt me-2"></i>Quay lại Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>