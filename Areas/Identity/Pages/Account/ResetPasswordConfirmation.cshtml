@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 text-center">
            <div class="card-body p-5">
                <div class="mb-4">
                    <span class="fa-stack fa-3x text-success">
                        <i class="fas fa-circle fa-stack-2x opacity-25"></i>
                        <i class="fas fa-check fa-stack-1x"></i>
                    </span>
                </div>

                <h2 class="fw-bold mb-3 text-success">Thành công!</h2>

                <p class="text-muted mb-4">
                    Mật khẩu của bạn đã được đặt lại.<br>
                    Bây giờ bạn có thể sử dụng mật khẩu mới để đăng nhập.
                </p>

                <div class="d-grid gap-2 col-8 mx-auto">
                    <a asp-page="./Login" class="btn btn-primary btn-lg fw-bold rounded-pill">
                        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>