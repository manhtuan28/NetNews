@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-7 p-5">
                    <div class="text-start mb-4">
                        <h2 class="fw-bold text-success"><i class="fas fa-user-plus me-2"></i>Đăng ký</h2>
                        <p class="text-muted small">Tham gia cộng đồng NetNews ngay hôm nay!</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email"><i class="fas fa-envelope me-1"></i> Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password"><i class="fas fa-lock me-1"></i> Mật khẩu</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword"><i class="fas fa-check-circle me-1"></i> Nhập lại mật khẩu</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button id="registerSubmit" type="submit" class="btn btn-success btn-lg fw-bold rounded-pill">Đăng ký ngay</button>
                        </div>
                    </form>

                    <hr>

                    <div class="text-center small">
                        Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none">Đăng nhập</a>
                    </div>
                </div>

                <div class="col-md-5 bg-light border-start p-5 d-flex flex-column justify-content-center align-items-center text-center">
                    <h5 class="fw-bold mb-3">Hoặc đăng ký bằng</h5>
                    <hr class="w-25 border-success mb-4">

                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div class="alert alert-light border text-muted small">
                                <i class="fas fa-info-circle mb-2 fs-4"></i><br />
                                Hiện tại chưa có cổng đăng ký ngoài (Google/Facebook) nào được cấu hình.
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="w-100">
                                <div class="d-grid gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-outline-secondary btn-lg bg-white position-relative" name="provider" value="@provider.Name" title="Đăng ký bằng @provider.DisplayName">
                                            @if (provider.Name == "Google")
                                            {
                                                <i class="fab fa-google text-danger position-absolute start-0 ms-3 top-50 translate-middle-y"></i>
                                            }
                                            else if (provider.Name == "Facebook")
                                            {

                                                <i class="fab fa-facebook-f text-primary position-absolute start-0 ms-3 top-50 translate-middle-y"></i>
                                            }
                                            else
                                            {

                                                <i class="fas fa-sign-in-alt position-absolute start-0 ms-3 top-50 translate-middle-y"></i>
                                            }
                                            @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}