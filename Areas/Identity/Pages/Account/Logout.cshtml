@page
@model LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="container pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0 rounded-3 p-5">
                <div class="mb-4">
                    <span class="fa-stack fa-3x text-secondary">
                        <i class="fas fa-circle fa-stack-2x opacity-25"></i>
                        <i class="fas fa-power-off fa-stack-1x"></i>
                    </span>
                </div>

                <h2 class="fw-bold mb-3">@ViewData["Title"]</h2>

                @{
                    if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <p class="text-muted mb-4">Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?</p>
                        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                                <i class="fas fa-sign-out-alt me-2"></i>Xác nhận Đăng xuất
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="lead text-muted mb-4">
                            Bạn đã đăng xuất thành công.<br />
                            Cảm ơn bạn đã sử dụng NetNews. Hẹn gặp lại!
                        </p>

                        <div class="d-flex justify-content-center gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-home me-2"></i>Về trang chủ
                            </a>
                            <a asp-page="./Login" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập lại
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>