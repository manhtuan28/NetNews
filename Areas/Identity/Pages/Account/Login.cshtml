@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-10 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-7 p-5">
                    <div class="text-start mb-4">
                        <h2 class="fw-bold text-primary"><i class="fas fa-sign-in-alt me-2"></i>Đăng nhập</h2>
                        <p class="text-muted small">Chào mừng trở lại với NetNews!</p>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="form-label"><i class="fas fa-envelope me-1"></i> Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="form-label"><i class="fas fa-lock me-1"></i> Mật khẩu</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label small text-muted" asp-for="Input.RememberMe">
                                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                                </label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small">Quên mật khẩu?</a>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button id="login-submit" type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill">Đăng nhập</button>
                        </div>
                    </form>

                    <div class="text-center small">
                        Chưa có tài khoản? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none">Đăng ký ngay</a>
                    </div>
                    <div class="text-center mt-2 small">
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted">Gửi lại email xác thực</a>
                    </div>
                </div>

                <div class="col-md-5 bg-light border-start p-5 d-flex flex-column justify-content-center align-items-center text-center">
                    <h5 class="fw-bold mb-3">Hoặc đăng nhập bằng</h5>
                    <hr class="w-25 border-primary mb-4">

                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div class="alert alert-light border text-muted small">
                                <i class="fas fa-info-circle mb-2 fs-4"></i><br />
                                Hiện tại chưa có cổng đăng nhập ngoài (Google/Facebook) nào được cấu hình.
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="w-100">
                                <div class="d-grid gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-outline-secondary btn-lg bg-white position-relative" name="provider" value="@provider.Name" title="Đăng nhập bằng @provider.DisplayName">
                                            @if (provider.Name == "Google")
                                            {
                                                <i class="fab fa-google text-danger position-absolute start-0 ms-3 top-50 translate-middle-y"></i>
                                            }
                                            else if (provider.Name == "Facebook")
                                            {

                                                <i class="fab fa-facebook-f text-primary position-absolute start-0 ms-3 top-50 translate-middle-y"></i>
                                            }
                                            else
                                            {

                                                <i class="fas fa-sign-in-alt position-absolute start-0 ms-3 top-50 translate-middle-y"></i>
                                            }
                                            @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}