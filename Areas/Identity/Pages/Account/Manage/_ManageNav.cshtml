@inject SignInManager<IdentityUser> SignInManager
@* [cite: 93] *@
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="nav nav-pills flex-column gap-2">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext) rounded-pill" id="profile" asp-page="./Index">
            <i class="fas fa-id-card me-2"></i>Hồ sơ
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext) rounded-pill" id="email" asp-page="./Email">
            <i class="fas fa-envelope me-2"></i>Email
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext) rounded-pill" id="change-password" asp-page="./ChangePassword">
            <i class="fas fa-key me-2"></i>Mật khẩu
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="nav-link @ManageNavPages.ExternalLoginsNavClass(ViewContext) rounded-pill" asp-page="./ExternalLogins">
                <i class="fas fa-share-alt me-2"></i>Liên kết ngoài
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) rounded-pill" id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="fas fa-shield-alt me-2"></i>Xác thực 2 lớp
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext) rounded-pill" id="personal-data" asp-page="./PersonalData">
            <i class="fas fa-user-shield me-2"></i>Dữ liệu cá nhân
        </a>
    </li>
</ul>