@page
@model DownloadPersonalDataModel
@{
    ViewData["Title"] = "Tải xuống dữ liệu của bạn";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold text-primary mb-3"><i class="fas fa-file-download me-2"></i>@ViewData["Title"]</h3>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">
        <div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex">
                <i class="fas fa-info-circle fs-4 me-3"></i>
                <div>
                    <p class="mb-1"><strong>Lưu ý:</strong> Tệp tin này chứa tất cả thông tin cá nhân liên quan đến tài khoản của bạn mà chúng tôi đang lưu giữ.</p>
                    <p class="mb-0 small">Dữ liệu sẽ được xuất ra định dạng <strong>.json</strong> để bạn có thể kiểm tra hoặc chuyển sang dịch vụ khác.</p>
                </div>
            </div>
        </div>

        <form asp-page="DownloadPersonalData" method="post" class="form-group">
            <button class="btn btn-primary btn-lg px-5 fw-bold rounded-pill shadow-sm" type="submit">
                <i class="fas fa-file-archive me-2"></i>Bắt đầu tải xuống (JSON)
            </button>
            <a asp-page="./PersonalData" class="btn btn-light btn-lg px-4 rounded-pill border ms-2">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}