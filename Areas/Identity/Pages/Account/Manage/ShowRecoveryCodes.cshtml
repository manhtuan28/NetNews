@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Mã khôi phục của bạn";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card border-0 shadow-sm">
    <div class="card-header bg-warning text-dark py-3">
        <h4 class="mb-0 fw-bold"><i class="fas fa-key me-2"></i>@ViewData["Title"]</h4>
    </div>
    <div class="card-body p-4">
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4">
            <i class="fas fa-exclamation-circle fs-3 me-3"></i>
            <div>
                <strong>Hãy lưu trữ những mã này ở nơi an toàn!</strong>
                <p class="mb-0">Nếu bạn mất thiết bị và không có mã khôi phục, bạn sẽ bị mất quyền truy cập vào tài khoản vĩnh viễn.</p>
            </div>
        </div>

        <div class="row g-3">
            @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
            {
                <div class="col-6">
                    <div class="p-2 border rounded bg-light text-center font-monospace fs-5 shadow-sm">
                        <code>@Model.RecoveryCodes[row]</code>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-2 border rounded bg-light text-center font-monospace fs-5 shadow-sm">
                        <code>@Model.RecoveryCodes[row + 1]</code>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-outline-primary rounded-pill px-4" onclick="window.print()">
                <i class="fas fa-print me-2"></i>In mã khôi phục
            </button>
            <a asp-page="./TwoFactorAuthentication" class="btn btn-primary rounded-pill px-4 fw-bold">
                Xong, tôi đã lưu mã
            </a>
        </div>
    </div>
</div>