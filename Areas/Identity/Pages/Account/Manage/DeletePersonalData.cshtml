@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Xóa tài khoản & Dữ liệu cá nhân";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold text-danger mb-3"><i class="fas fa-user-slash me-2"></i>@ViewData["Title"]</h3>

<div class="alert alert-danger shadow-sm border-0 d-flex align-items-center" role="alert">
    <i class="fas fa-exclamation-triangle fs-4 me-3"></i>
    <div>
        <strong>Cảnh báo cực kỳ quan trọng:</strong> Việc xóa dữ liệu này sẽ gỡ bỏ vĩnh viễn tài khoản của bạn. Mọi dữ liệu liên quan sẽ mất và <strong>không thể khôi phục lại được.</strong>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">
        <form id="delete-user" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            @if (Model.RequirePassword)
            {
                <p class="text-muted mb-3">Vui lòng nhập mật khẩu của bạn để xác nhận yêu cầu xóa tài khoản:</p>
                <div class="form-floating mb-4">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Nhập mật khẩu" />
                    <label asp-for="Input.Password"><i class="fas fa-lock me-1"></i> Mật khẩu xác nhận</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
            }

            <div class="d-flex gap-2">
                <button class="btn btn-danger btn-lg px-4 fw-bold rounded-pill shadow-sm" type="submit">
                    <i class="fas fa-trash-alt me-2"></i>Xóa vĩnh viễn tài khoản
                </button>
                <a asp-page="./PersonalData" class="btn btn-light btn-lg px-4 rounded-pill border">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}