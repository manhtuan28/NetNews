@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary text-white p-3 rounded-3 shadow-sm me-3">
            <i class="fas fa-user-gear fa-2x"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark mb-0">Thiết lập tài khoản</h2>
            <p class="text-muted mb-0">Quản lý thông tin cá nhân và cài đặt bảo mật của bạn</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="row g-0">
                <div class="col-md-3 bg-light border-end p-4">
                    <h6 class="text-uppercase fw-bold text-muted small mb-4 px-3">Danh mục cài đặt</h6>
                    <partial name="_ManageNav" />
                </div>

                <div class="col-md-9 p-4 p-lg-5">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}