@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Thiết lập ứng dụng xác thực (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="fw-bold text-primary mb-4"><i class="fas fa-user-shield me-2"></i>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted">Để sử dụng ứng dụng xác thực, vui lòng thực hiện theo các bước sau:</p>
                
                <ol class="list-group list-group-numbered border-0">
                    <li class="list-group-item border-0 ps-0 mb-3">
                        <strong>Tải xuống ứng dụng xác thực:</strong>
                        <p class="small text-muted mb-2">Bạn có thể sử dụng Microsoft Authenticator hoặc Google Authenticator.</p>
                        <div class="btn-group btn-group-sm">
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" class="btn btn-outline-dark" target="_blank"><i class="fab fa-android me-1"></i>Android</a>
                            <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605" class="btn btn-outline-dark" target="_blank"><i class="fab fa-apple me-1"></i>iOS</a>
                        </div>
                    </li>

                    <li class="list-group-item border-0 ps-0 mb-3">
                        <strong>Quét mã QR hoặc nhập khóa:</strong>
                        <p class="small text-muted mb-2">Sử dụng ứng dụng để quét mã QR bên dưới hoặc nhập thủ công mã khóa này:</p>
                        <div class="bg-light p-2 rounded mb-3">
                            <kbd class="fs-6 px-3 py-2 bg-dark shadow-sm">@Model.SharedKey</kbd>
                        </div>
                        <div id="qrCode" class="mb-3 d-flex justify-content-center"></div>
                        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                        
                        <div class="alert alert-info border-0 py-2 small">
                            <i class="fas fa-info-circle me-1"></i> Lưu ý: Khoảng trắng và chữ hoa/thường không quan trọng.
                        </div>
                    </li>

                    <li class="list-group-item border-0 ps-0">
                        <strong>Xác nhận mã:</strong>
                        <p class="small text-muted mb-3">Sau khi quét mã, ứng dụng sẽ cung cấp cho bạn một mã gồm 6 số. Hãy nhập nó vào bên dưới.</p>
                        
                        <div class="row">
                            <div class="col-md-8">
                                <form id="send-code" method="post">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Nhập mã 6 số" />
                                        <label asp-for="Input.Code"><i class="fas fa-lock me-1"></i> Mã xác thực</label>
                                        <span asp-validation-for="Input.Code" class="text-danger small"></span>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow">
                                        <i class="fas fa-check-circle me-1"></i> Xác minh và Kích hoạt
                                    </button>
                                    <div asp-validation-summary="ModelOnly" class="text-danger small mt-2" role="alert"></div>
                                </form>
                            </div>
                        </div>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}