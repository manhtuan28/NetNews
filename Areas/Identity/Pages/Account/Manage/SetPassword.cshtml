@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Thiết lập mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="fw-bold text-primary mb-3"><i class="fas fa-key me-2"></i>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-start mb-4">
            <i class="fas fa-info-circle fs-4 me-3 mt-1"></i>
            <p class="mb-0">
                Bạn chưa có mật khẩu cục bộ cho tài khoản này.
                Vui lòng thêm mật khẩu để bạn có thể đăng nhập trực tiếp mà không cần sử dụng tài khoản liên kết bên ngoài.
            </p>
        </div>

        <div class="row">
            <div class="col-md-8 col-lg-6">
                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control rounded-3" autocomplete="new-password" placeholder="Nhập mật khẩu mới" />
                        <label asp-for="Input.NewPassword" class="form-label">Mật khẩu mới</label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" placeholder="Xác nhận mật khẩu" />
                        <label asp-for="Input.ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold rounded-pill shadow-sm w-100 w-md-auto">
                        Thiết lập mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}