@page
@model Disable2faModel
@{
    ViewData["Title"] = "Tắt xác thực hai lớp (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="fw-bold text-warning mb-3"><i class="fas fa-shield-virus me-2"></i>@ViewData["Title"]</h3>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">
        <div class="alert alert-warning border-0 shadow-sm mb-4" role="alert">
            <p class="mb-2">
                <i class="fas fa-exclamation-circle me-2"></i><strong>Hành động này chỉ tắt xác thực hai lớp (2FA).</strong>
            </p>
            <p class="mb-0 small text-dark">
                Việc tắt 2FA không làm thay đổi các khóa trong ứng dụng xác thực của bạn. Nếu bạn muốn thay đổi khóa được sử dụng trong ứng dụng xác thực, bạn nên
                <a asp-page="./ResetAuthenticator" class="fw-bold text-decoration-none">thiết lập lại khóa xác thực của mình.</a>
            </p>
        </div>

        <form method="post">
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-danger btn-lg px-4 fw-bold rounded-pill shadow-sm" type="submit">
                    <i class="fas fa-power-off me-2"></i>Xác nhận tắt 2FA
                </button>
                <a asp-page="./TwoFactorAuthentication" class="btn btn-light btn-lg px-4 rounded-pill border">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>