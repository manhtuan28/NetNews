@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Quản lý dữ liệu cá nhân";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="fw-bold text-primary mb-4"><i class="fas fa-database me-2"></i>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <p class="text-muted">
                    Tài khoản của bạn chứa các thông tin cá nhân mà bạn đã cung cấp cho chúng tôi.
                    Trang này cho phép bạn tải xuống hoặc xóa các dữ liệu đó.
                </p>

                <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="fas fa-exclamation-triangle fs-4 me-3"></i>
                    <div>
                        <strong>Lưu ý quan trọng:</strong> Việc xóa dữ liệu sẽ gỡ bỏ tài khoản của bạn
                        <strong>vĩnh viễn</strong> và không thể khôi phục lại được.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <form id="download-data" asp-page="DownloadPersonalData" method="post">
                        <button class="btn btn-primary btn-lg px-4 fw-bold rounded-pill shadow-sm" type="submit">
                            <i class="fas fa-download me-2"></i>Tải về dữ liệu (.json)
                        </button>
                    </form>

                    <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger btn-lg px-4 fw-bold rounded-pill">
                        <i class="fas fa-user-slash me-2"></i>Xóa tài khoản
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}