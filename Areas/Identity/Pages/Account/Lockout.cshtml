@page
@model LockoutModel
@{
    ViewData["Title"] = "Tài khoản bị khóa";
}

<div class="container pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-3 text-center">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="fw-bold mb-0"><i class="fas fa-user-lock me-2"></i>@ViewData["Title"]</h4>
                </div>
                <div class="card-body p-5">
                    <div class="mb-4">
                        <span class="fa-stack fa-3x text-danger">
                            <i class="fas fa-circle fa-stack-2x opacity-25"></i>
                            <i class="fas fa-lock fa-stack-1x"></i>
                        </span>
                    </div>

                    <h2 class="h4 fw-bold text-secondary mb-3">Tạm thời ngừng truy cập</h2>

                    <p class="text-muted mb-4">
                        Tài khoản này đã bị khóa tạm thời do nhập sai mật khẩu quá nhiều lần.<br>
                        Vui lòng quay lại sau ít phút hoặc liên hệ quản trị viên để được hỗ trợ.
                    </p>

                    <div class="d-grid gap-2 col-8 mx-auto">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                            <i class="fas fa-home me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>