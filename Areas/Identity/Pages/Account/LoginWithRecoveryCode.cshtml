@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Dùng mã khôi phục";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-warning text-dark text-center py-4">
                <h3 class="fw-bold mb-0"><i class="fas fa-life-ring me-2"></i>@ViewData["Title"]</h3>
            </div>
            <div class="card-body p-5">
                <div class="alert alert-info border-0 small" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    Bạn đang yêu cầu đăng nhập bằng mã khôi phục. Đăng nhập này sẽ không được ghi nhớ cho đến khi bạn cung cấp mã từ ứng dụng xác thực hoặc tắt 2FA và đăng nhập lại.
                </div>

                <p class="text-center text-muted mb-4">
                    Nhập một trong các mã khôi phục dự phòng bạn đã lưu để tiếp tục.
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.RecoveryCode" class="form-control text-center fs-4 fw-bold tracking-widest" autocomplete="off" placeholder="RecoveryCode" />
                        <label asp-for="Input.RecoveryCode" class="form-label text-center w-100">Nhập mã khôi phục</label>
                        <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-widest {
        letter-spacing: 0.2em;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}