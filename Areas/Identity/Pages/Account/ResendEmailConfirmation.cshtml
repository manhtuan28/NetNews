@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Gửi lại email xác thực";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-4">
                <h3 class="fw-bold mb-0">
                    <i class="fas fa-envelope-open-text me-2"></i>@ViewData["Title"]
                </h3>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-4 text-muted">
                    <small>Nhập địa chỉ email tài khoản của bạn. Chúng tôi sẽ gửi lại liên kết kích hoạt mới.</small>
                </div>

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 small" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Địa chỉ Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill">
                            <i class="fas fa-paper-plane me-2"></i>Gửi lại
                        </button>
                    </div>
                </form>

                <hr class="my-4">

                <div class="text-center">
                    <a asp-page="./Login" class="text-decoration-none small">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}