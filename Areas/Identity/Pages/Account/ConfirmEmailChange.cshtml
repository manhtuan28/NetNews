@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Xác thực thay đổi Email";
}

<div class="container pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <span class="fa-stack fa-3x text-primary">
                            <i class="fas fa-circle fa-stack-2x opacity-25"></i>
                            <i class="fas fa-envelope-open-text fa-stack-1x"></i>
                        </span>
                    </div>

                    <h2 class="fw-bold mb-3">@ViewData["Title"]</h2>

                    <div class="alert alert-light border-0" role="alert">
                        <partial name="_StatusMessage" model="Model.StatusMessage" />
                    </div>

                    <p class="text-muted">
                        Email mới của bạn đã được cập nhật vào hệ thống.
                    </p>

                    <div class="mt-4">
                        <a asp-page="./Manage/Index" class="btn btn-primary px-4 rounded-pill fw-bold">
                            <i class="fas fa-user-cog me-2"></i>Về trang quản lý tài khoản
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>