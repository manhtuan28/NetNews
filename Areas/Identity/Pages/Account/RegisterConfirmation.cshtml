@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác thực đăng ký";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0 rounded-3 text-center">
            <div class="card-header bg-success text-white py-3">
                <h4 class="fw-bold mb-0"><i class="fas fa-envelope-open-text me-2"></i>@ViewData["Title"]</h4>
            </div>
            <div class="card-body p-5">
                @{
                    if (@Model.DisplayConfirmAccountLink)
                    {
                        <div class="alert alert-warning border-0" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Lưu ý:</strong> Hệ thống đang chạy chế độ thử nghiệm (hoặc chưa cấu hình gửi mail).
                        </div>
                        <p class="mb-4">
                            Để hoàn tất quy trình, bạn vui lòng bấm vào nút bên dưới để giả lập việc xác thực tài khoản:
                        </p>
                        <div class="d-grid gap-2 col-8 mx-auto">
                            <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn btn-success btn-lg fw-bold rounded-pill">
                                <i class="fas fa-check-circle me-2"></i>Xác thực ngay
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="mb-4">
                            <span class="fa-stack fa-3x text-success">
                                <i class="fas fa-circle fa-stack-2x opacity-25"></i>
                                <i class="fas fa-paper-plane fa-stack-1x"></i>
                            </span>
                        </div>
                        <h5 class="fw-bold">Đã gửi email kích hoạt!</h5>
                        <p class="text-muted mb-4">
                            Vui lòng kiểm tra hộp thư <strong>@Model.Email</strong> và làm theo hướng dẫn trong email để kích hoạt tài khoản.
                        </p>
                        <div class="alert alert-info small border-0">
                            <i class="fas fa-info-circle me-1"></i>
                            Nếu không thấy email, hãy kiểm tra thư mục Spam hoặc thử đăng nhập lại để gửi lại mã.
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>\