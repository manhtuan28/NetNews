@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-lg border-0 rounded-3">
            <div class="card-header bg-info text-white text-center py-4">
                <h3 class="fw-bold mb-0">
                    <i class="fas fa-plug me-2"></i>Liên kết tài khoản @Model.ProviderDisplayName
                </h3>
            </div>
            <div class="card-body p-5">
                <div class="alert alert-success border-0 d-flex align-items-center" role="alert">
                    <i class="fas fa-check-circle fa-2x me-3"></i>
                    <div>
                        Bạn đã xác thực thành công với <strong>@Model.ProviderDisplayName</strong>.
                        <br>Vui lòng nhập địa chỉ email bên dưới để hoàn tất việc đăng ký tài khoản trên NetNews.
                    </div>
                </div>

                <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Nhập email của bạn..." />
                        <label asp-for="Input.Email" class="form-label">Địa chỉ Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">
                            <i class="fas fa-user-check me-2"></i>Hoàn tất đăng ký
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}