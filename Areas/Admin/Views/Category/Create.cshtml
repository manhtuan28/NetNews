@model NetNews.Models.Category

@{
    ViewData["Title"] = "Tạo danh mục mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fas fa-folder-plus me-2"></i>@ViewData["Title"]</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên danh mục</label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Công nghệ, Thể thao..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ParentId" class="form-label fw-bold">Danh mục cha</label>
                        <select asp-for="ParentId" class="form-select" asp-items="ViewBag.ParentList">
                            <option value="">-- Là danh mục gốc (Không có cha) --</option>
                        </select>
                        <small class="text-muted">Nếu chọn, danh mục này sẽ là con của danh mục được chọn.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label fw-bold">Đường dẫn tĩnh (Slug)</label>
                        <input asp-for="Slug" class="form-control" placeholder="Để trống sẽ tự động tạo từ tên..." />
                        <small class="text-muted">Dùng cho URL thân thiện SEO (vd: cong-nghe)</small>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" checked>
                        <label class="form-check-label" asp-for="IsActive">Kích hoạt ngay</label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-2"></i>Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}