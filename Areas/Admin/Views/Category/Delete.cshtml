@model NetNews.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 border-top border-5 border-danger position-relative">
            <div class="position-absolute start-50 translate-middle-x bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shadow"
                 style="width: 80px; height: 80px; top: -40px;">
                <i class="fas fa-trash-alt fa-2x"></i>
            </div>

            <div class="card-body p-4 pt-5 text-center mt-3">
                <h4 class="fw-bold text-dark mt-3">Xóa danh mục này?</h4>
                <p class="text-muted mb-4">Bạn đang thực hiện xóa danh mục <strong>"@Model.Name"</strong></p>

                @if (Model.SubCategories != null && Model.SubCategories.Any())
                {
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-start rounded-3 mb-4">
                        <div class="d-flex">
                            <i class="fas fa-exclamation-triangle text-danger mt-1 me-3 fa-lg"></i>
                            <div>
                                <strong class="text-danger text-uppercase">Cảnh báo nghiêm trọng</strong><br />
                                Danh mục này có <strong>@Model.SubCategories.Count</strong> danh mục con.<br />
                                <span class="small">Nếu tiếp tục, tất cả danh mục con cũng sẽ bị xóa vĩnh viễn!</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-0 text-dark small mb-4">
                        <i class="fas fa-info-circle me-1"></i> Hành động này không thể hoàn tác.
                    </div>
                }

                <div class="bg-light p-3 rounded mb-4 text-start small">
                    <div class="row">
                        <div class="col-4 text-muted">Slug:</div>
                        <div class="col-8 fw-bold">/@Model.Slug</div>
                    </div>
                    <div class="row mt-1">
                        <div class="col-4 text-muted">Trạng thái:</div>
                        <div class="col-8">@(Model.IsActive ? "Đang hiện" : "Đang ẩn")</div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-2">
                        <div class="col-6">
                            <a asp-action="Index" class="btn btn-light w-100 fw-bold text-muted">Hủy bỏ</a>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn btn-danger w-100 fw-bold shadow-sm">
                                Xóa vĩnh viễn
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>