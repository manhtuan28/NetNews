@model IEnumerable<NetNews.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-list-alt me-2"></i>Danh sách danh mục</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill">
            <i class="fas fa-plus me-1"></i> Thêm mới
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3 rounded-3 border-0 shadow-sm">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase small fw-bold text-muted">
                    <tr>
                        <th class="ps-4">Tên danh mục</th>
                        <th>Cấp độ</th>
                        <th>Slug</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (item.ParentId == null)
                                    {
                                        <strong class="text-primary"><i class="fas fa-folder me-2"></i>@item.Name</strong>
                                    }
                                    else
                                    {
                                        <div class="ms-4 text-dark">
                                            <i class="fas fa-level-up-alt fa-rotate-90 me-2 text-secondary"></i>@item.Name
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (item.ParentId == null)
                                    {
                                        <span class="badge bg-primary">ROOT</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">
                                            Con của: @item.Parent?.Name
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">/@item.Slug</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <i class="fas fa-check-circle text-success" title="Hiển thị"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-danger" title="Ẩn"></i>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-warning" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>