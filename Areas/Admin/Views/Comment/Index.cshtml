@model IEnumerable<NetNews.Areas.Admin.Models.CommentManagementViewModel>

@{
    ViewData["Title"] = "Quản lý Bình luận";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-comments me-2"></i>@ViewData["Title"]</h5>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3 border-0 shadow-sm">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light small text-uppercase fw-bold text-muted">
                    <tr>
                        <th class="ps-4">Người dùng</th>
                        <th>Nội dung bình luận</th>
                        <th>Đánh giá</th>
                        <th>Bài viết</th>
                        <th>Ngày gửi</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@item.UserName</div>
                                @if (item.IsReply)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info px-2 py-1 rounded-pill small">Phản hồi</span>
                                }
                            </td>
                            <td>
                                <div class="text-wrap" style="max-width: 300px;">@item.Content</div>
                            </td>
                            <td>
                                <div class="text-warning small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= item.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <a href="/Post/Details/@item.PostSlug" target="_blank" class="text-decoration-none small text-truncate d-block" style="max-width: 200px;">
                                    @item.PostTitle
                                </a>
                            </td>
                            <td class="small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bình luận này?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle shadow-sm">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>