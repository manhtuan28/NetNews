@model List<NetNews.Models.Post>

@{
    ViewData["Title"] = "Tổng quan hệ thống";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Xin chào, @User.Identity?.Name! 👋</h4>
            <p class="text-muted mb-0">Đây là những gì đang diễn ra trên hệ thống hôm nay.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <div class="bg-white px-3 py-2 rounded shadow-sm border">
                <i class="far fa-calendar-alt text-primary me-2"></i>
                <span class="fw-bold text-dark">@DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm overflow-hidden h-100 card-hover">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-circle me-3">
                            <i class="fas fa-newspaper fa-lg"></i>
                        </div>
                        <h6 class="mb-0 fw-bold text-muted text-uppercase small ls-1">Bài viết</h6>
                    </div>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@ViewBag.PostCount</h2>
                    <div class="position-absolute bottom-0 end-0 p-3 opacity-10">
                        <i class="fas fa-newspaper fa-4x text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm overflow-hidden h-100 card-hover">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-success bg-opacity-10 text-success rounded-circle me-3">
                            <i class="fas fa-folder fa-lg"></i>
                        </div>
                        <h6 class="mb-0 fw-bold text-muted text-uppercase small ls-1">Danh mục</h6>
                    </div>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@ViewBag.CategoryCount</h2>
                    <div class="position-absolute bottom-0 end-0 p-3 opacity-10">
                        <i class="fas fa-folder fa-4x text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm overflow-hidden h-100 card-hover">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-warning bg-opacity-10 text-warning rounded-circle me-3">
                            <i class="fas fa-users fa-lg"></i>
                        </div>
                        <h6 class="mb-0 fw-bold text-muted text-uppercase small ls-1">Thành viên</h6>
                    </div>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@ViewBag.UserCount</h2>
                    <div class="position-absolute bottom-0 end-0 p-3 opacity-10">
                        <i class="fas fa-users fa-4x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm overflow-hidden h-100 card-hover">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-info bg-opacity-10 text-info rounded-circle me-3">
                            <i class="fas fa-eye fa-lg"></i>
                        </div>
                        <h6 class="mb-0 fw-bold text-muted text-uppercase small ls-1">Tổng lượt xem</h6>
                    </div>
                    <h2 class="display-6 fw-bold mb-0 text-dark">@ViewBag.TotalViews</h2>
                    <div class="position-absolute bottom-0 end-0 p-3 opacity-10">
                        <i class="fas fa-chart-line fa-4x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="fas fa-history me-2 text-primary"></i>Bài viết mới nhất</h5>
                    <a href="/Admin/Post" class="btn btn-sm btn-light text-primary fw-bold">Xem tất cả <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted">
                                <tr>
                                    <th class="ps-4">Tiêu đề bài viết</th>
                                    <th>Tác giả</th>
                                    <th>Ngày đăng</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end pe-4">Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.Thumbnail))
                                                {
                                                    <img src="@item.Thumbnail" class="rounded me-3 object-fit-cover" width="40" height="40" alt="">
                                                }
                                                else
                                                {
                                                    <div class="rounded me-3 bg-light d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-bold text-dark text-truncate" style="max-width: 300px;">@item.Title</div>
                                                    <small class="text-muted">@item.Category?.Name</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 25px; height: 25px; font-size: 0.7rem;">
                                                    @(item.Author?.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                                </div>
                                                <span class="small fw-bold">@item.Author?.UserName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted small">
                                            <i class="far fa-clock me-1"></i> @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            @if (item.IsPublished)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Đã đăng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">Bản nháp</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="/Admin/Post/Edit/@item.Id" class="btn btn-sm btn-icon btn-light text-secondary rounded-circle">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-1 {
        letter-spacing: 1px;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .object-fit-cover {
        object-fit: cover;
    }

    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        line-height: 32px;
    }
</style>