@model List<NetNews.Areas.Admin.Models.UserViewModel>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-users-cog me-2"></i>@ViewData["Title"]</h5>
            <small class="text-muted">Quản lý tài khoản và phân quyền hệ thống</small>
        </div>
        <a asp-action="Create" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm">
            <i class="fas fa-user-plus me-1"></i> Thêm thành viên
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3 rounded-3 border-0 shadow-sm d-flex align-items-center">
                <i class="fas fa-check-circle me-2 fa-lg"></i>
                <div>@TempData["Success"]</div>
            </div>
        }

        <div class="table-responsive" style="min-height: 400px; padding-bottom: 150px;">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase small fw-bold text-muted">
                    <tr>
                        <th class="ps-4">Thành viên</th>
                        <th>Vai trò (Roles)</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold shadow-sm"
                                         style="width: 40px; height: 40px; font-size: 1.1rem;">
                                        @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.UserName</div>
                                        <div class="small text-muted">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        if (role == "Admin")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill">@role</span>
                                        }
                                        else if (role == "Editor")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-2 py-1 rounded-pill">@role</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 rounded-pill">@role</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Chưa phân quyền</span>
                                }
                            </td>
                            <td>
                                @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                {
                                    <span class="badge bg-danger"><i class="fas fa-lock me-1"></i>Đang khóa</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Hoạt động</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="dropdown position-static">
                                    <button class="btn btn-light btn-sm rounded-circle shadow-sm" type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <i class="fas fa-ellipsis-v text-muted"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg" style="z-index: 9999;">
                                        <li><h6 class="dropdown-header">Thao tác</h6></li>
                                        <li>
                                            <a asp-action="ManageRoles" asp-route-userId="@user.Id" class="dropdown-item">
                                                <i class="fas fa-user-tag me-2 text-primary"></i> Phân quyền
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="dropdown-item">
                                                <i class="fas fa-user-edit me-2 text-info"></i> Sửa thông tin
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-action="ResetPassword" asp-route-id="@user.Id" class="dropdown-item">
                                                <i class="fas fa-key me-2 text-warning"></i> Đổi mật khẩu
                                            </a>
                                        </li>

                                        @if (User.Identity.Name != user.UserName)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a asp-action="LockUnlock" asp-route-id="@user.Id" class="dropdown-item">
                                                    @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                                    {
                                                        <span class="text-success fw-bold"><i class="fas fa-unlock me-2"></i> Mở khóa</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-warning fw-bold"><i class="fas fa-lock me-2"></i> Khóa tài khoản</span>
                                                    }
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-action="Delete" asp-route-id="@user.Id" class="dropdown-item text-danger fw-bold">
                                                    <i class="fas fa-trash-alt me-2"></i> Xóa vĩnh viễn
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>