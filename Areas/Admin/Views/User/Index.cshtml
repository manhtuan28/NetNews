@model List<NetNews.Areas.Admin.Models.UserViewModel>

@{
    ViewData["Title"] = "Quản lý thành viên";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-users-cog me-2"></i>@ViewData["Title"]</h5>
        <a asp-action="Create" class="btn btn-success btn-sm rounded-pill fw-bold">
            <i class="fas fa-plus me-1"></i> Thêm User
        </a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tài khoản / Email</th>
                        <th>Quyền hạn (Roles)</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@user.UserName</div>
                                <small class="text-muted">@user.Email</small>
                            </td>
                            <td>
                                @if (user.Roles.Any())
                                {
                                    @foreach (var role in user.Roles)
                                    {
                                        if (role == "Admin")
                                        {
                                            <span class="badge bg-danger">@role</span>
                                        }
                                        else if (role == "Editor")
                                        {
                                            <span class="badge bg-warning text-dark">@role</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@role</span>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa phân quyền</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="ManageRoles" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-primary rounded-pill me-1" title="Phân quyền">
                                    <i class="fas fa-user-tag"></i>
                                </a>

                                @if (User.Identity.Name != user.UserName)
                                {
                                    @if (user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow)
                                    {
                                        <a asp-action="LockUnlock" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-success rounded-pill me-1"
                                           title="Mở khóa tài khoản này">
                                            <i class="fas fa-unlock"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="LockUnlock" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-warning text-dark rounded-pill me-1"
                                           title="Khóa tài khoản này"
                                           onclick="return confirm('Bạn có chắc muốn KHÓA tài khoản này?')">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    }

                                    <a asp-action="Delete" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-danger rounded-pill"
                                       title="Xóa vĩnh viễn">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>