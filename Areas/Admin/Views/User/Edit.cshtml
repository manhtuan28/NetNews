@model NetNews.Areas.Admin.Models.EditUserViewModel

@{
    ViewData["Title"] = "Cập nhật thông tin";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-info"><i class="fas fa-user-edit me-2"></i>@ViewData["Title"]</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserName" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Tài khoản</label>
                        <input value="@Model.UserName" class="form-control bg-light" disabled />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">Số điện thoại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-phone text-muted"></i></span>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-info text-white fw-bold py-2 shadow-sm">
                            <i class="fas fa-save me-2"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-light border">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}