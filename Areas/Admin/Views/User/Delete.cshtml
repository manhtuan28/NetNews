@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Xóa thành viên";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 border-top border-5 border-danger">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="fas fa-user-times fa-4x text-danger opacity-75"></i>
                </div>

                <h3 class="fw-bold mb-3">Xóa tài khoản vĩnh viễn?</h3>

                <div class="alert alert-warning text-start border-0 bg-warning bg-opacity-10">
                    <p class="mb-1"><strong>Tài khoản:</strong> @Model.UserName (@Model.Email)</p>
                    <hr class="my-2">
                    <p class="mb-0 text-danger fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i>Cảnh báo:
                    </p>
                    <ul class="mb-0 small text-danger">
                        <li>Hành động này <strong>không thể hoàn tác</strong>.</li>
                        <li>User sẽ bị xóa khỏi hệ thống.</li>
                        @if (ViewBag.PostCount > 0)
                        {
                            <li><strong>@ViewBag.PostCount bài viết</strong> của user này cũng sẽ bị xóa sạch!</li>
                        }
                    </ul>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Quay lại</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold rounded-pill">
                            <i class="fas fa-trash-alt me-2"></i> Xác nhận xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>