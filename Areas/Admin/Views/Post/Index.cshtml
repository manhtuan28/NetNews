@model IEnumerable<NetNews.Models.Post>
@{
    ViewData["Title"] = "Quản lý Bài viết";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-newspaper me-2"></i>Danh sách bài viết</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill"><i class="fas fa-plus me-1"></i> Viết bài mới</a>
    </div>
    <div class="card-body p-0">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success m-3">@TempData["Success"]</div>
        }
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Ảnh</th>
                        <th>Tiêu đề / Danh mục</th>
                        <th>Tác giả</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(item.Thumbnail))
                                {
                                    <img src="@item.Thumbnail" class="rounded" style="width: 80px; height: 50px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white small" style="width: 80px; height: 50px;">No Image</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 300px;">
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge bg-danger me-1">HOT</span>
                                    }
                                    @item.Title
                                </div>
                                <span class="badge bg-light text-secondary border">@item.Category?.Name</span>
                            </td>
                            <td><small>@item.Author?.UserName</small></td>
                            <td><small class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</small></td>
                            <td>
                                @if (item.IsPublished)
                                {
                                    <span class="badge bg-success">Public</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Draft</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-primary"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger"><i class="fas fa-trash-alt"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>