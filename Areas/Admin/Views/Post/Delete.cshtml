@model NetNews.Models.Post

@{
    ViewData["Title"] = "Xóa bài viết";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 border-top border-5 border-danger">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="fas fa-trash-alt fa-3x text-danger"></i>
                    </div>
                </div>

                <h3 class="fw-bold mb-3 text-dark">Xóa bài viết này?</h3>
                <p class="text-muted mb-4">Hành động này sẽ xóa vĩnh viễn bài viết khỏi cơ sở dữ liệu và không thể hoàn tác.</p>

                <div class="card border-0 bg-light mb-4 text-start overflow-hidden">
                    <div class="row g-0 align-items-center">
                        <div class="col-3">
                            @if (!string.IsNullOrEmpty(Model.Thumbnail))
                            {
                                <img src="@Model.Thumbnail" class="img-fluid h-100 object-fit-cover" style="min-height: 90px;" />
                            }
                            else
                            {
                                <div class="bg-secondary h-100 d-flex align-items-center justify-content-center text-white small" style="min-height: 90px;">No Img</div>
                            }
                        </div>
                        <div class="col-9">
                            <div class="card-body py-2">
                                <h6 class="card-title fw-bold mb-1 text-truncate">@Model.Title</h6>
                                <div class="small text-muted">
                                    <i class="fas fa-folder me-1"></i> @Model.Category?.Name &bull;
                                    <i class="fas fa-user ms-1 me-1"></i> @Model.Author?.UserName
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 d-md-block">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold text-muted me-md-2">Hủy bỏ</a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash-alt me-2"></i> Xác nhận xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>